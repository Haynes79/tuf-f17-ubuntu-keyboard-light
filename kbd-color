#!/usr/bin/env python3
"""kbd-color: tiny keyboard light controller for ASUS laptops (asus-wmi sysfs).

  kbd-color red                 solid colour by name
  kbd-color ff8800              solid colour by hex
  kbd-color cycle [speed]       effects: static breathe cycle strobe
  kbd-color battery             colour follows battery level (red low -> green full)
  kbd-color heat                colour follows CPU temperature (blue cool -> red hot)
  kbd-color breathe blue slow   effect + colour + speed (slow|medium|fast)
  kbd-color next | prev         switch to the next / previous effect (Fn+Left does "next")
  kbd-color brightness 0-3
  kbd-color off | on
  kbd-color power awake on      keyboard light on boot / awake / sleep: on|off
  kbd-color apply               re-apply the saved setting (used at login)
  kbd-color daemon              keeps battery/heat colours live, handles the Fn+Left hotkey
                                (run by the systemd user service)
  kbd-color keys                print the codes ASUS hotkeys send (for finding new hotkeys)
  kbd-color gui                 small window
"""
import colorsys
import functools
import glob
import json
import os
import select
import signal
import struct
import subprocess
import sys
import time

LED = os.environ.get("KBD_COLOR_LED", "/sys/class/leds/asus::kbd_backlight")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "kbd-color.json")

# Effect numbers as used by G-Helper / the asus-wmi driver.
MODES = {"static": 0, "breathe": 1, "cycle": 2, "strobe": 10}
# Software-driven "effects": the daemon turns a sensor reading into a static colour.
DYNAMIC = ("battery", "heat")
EFFECTS = list(MODES) + list(DYNAMIC)
LABELS = {"static": "Static", "breathe": "Breathe", "cycle": "Color cycle", "strobe": "Strobe",
          "battery": "Battery level", "heat": "CPU temperature"}
NO_COLOR = {"cycle", *DYNAMIC}       # these pick their own colours
NO_SPEED = {"static", *DYNAMIC}        # these don't animate
POWER = ("boot", "awake", "sleep")
SPEEDS = {"slow": 0, "medium": 1, "fast": 2}
COLORS = {
    "red": (255, 0, 0), "green": (0, 255, 0), "blue": (0, 0, 255),
    "white": (255, 255, 255), "yellow": (255, 255, 0), "cyan": (0, 255, 255),
    "magenta": (255, 0, 255), "purple": (128, 0, 255), "orange": (255, 100, 0),
    "pink": (255, 60, 150),
}
# ASUS WMI hotkey codes (from `kbd-color keys`) -> effect step. Fn+Left sends 0xb2;
# Fn+Right sends nothing to Linux on the FX706HF, so Fn+Left cycles forward and wraps.
HOTKEYS = {0xb2: 1}
HOTKEY_DEVICE = "Asus WMI hotkeys"
DEFAULT = {"mode": "static", "rgb": [255, 255, 255], "speed": "medium", "brightness": 3,
           "boot": True, "awake": True, "sleep": True}


def load(live=True):
    """Saved setting. With live=True the brightness is the keyboard's current one, since
    Fn+Up/Down change it without going through kbd-color."""
    try:
        with open(CONF) as f:
            cfg = {**DEFAULT, **json.load(f)}
        if cfg["mode"] == "rainbow":  # removed: this keyboard has no rainbow, colour cycle is its version
            cfg["mode"] = "cycle"
        if cfg["mode"] not in EFFECTS:  # e.g. another effect that was removed
            cfg["mode"] = "static"
    except (OSError, ValueError):
        cfg = dict(DEFAULT)
    if live:
        b = read_int(os.path.join(LED, "brightness"))
        if b is not None:
            cfg["brightness"] = b
    return cfg


def save(cfg):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f)
    os.replace(tmp, CONF)  # atomic, so the daemon / app never read a half-written file


class KbdError(Exception):
    pass


def write(name, value):
    path = os.path.join(LED, name)
    try:
        with open(path, "w") as f:
            f.write(value)
    except PermissionError:
        raise KbdError(f"No permission to write {path}. Run ./install.sh from the kbd-color project first.")
    except OSError as e:
        raise KbdError(f"{path}: {e}")


def read_text(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def read_int(path):
    try:
        return int(read_text(path))
    except (TypeError, ValueError):
        return None


# Sensor files are looked up once; after that each reading is a single small read.
@functools.cache
def battery_path():
    return next((p for p in sorted(glob.glob("/sys/class/power_supply/BAT*/capacity"))), None)


@functools.cache
def cpu_temp_path():
    for d in glob.glob("/sys/class/hwmon/hwmon*"):
        if read_text(d + "/name") == "coretemp":
            return d + "/temp1_input"
    for d in glob.glob("/sys/class/thermal/thermal_zone*"):
        if read_text(d + "/type") == "x86_pkg_temp":
            return d + "/temp"
    return None


def battery_percent():
    p = battery_path()
    return p and read_int(p)


def cpu_temp():
    """CPU package temperature in degrees C, or None."""
    p = cpu_temp_path()
    v = p and read_int(p)
    return None if v is None else v / 1000


def hue_rgb(hue):
    hue = round(hue / 5) * 5  # coarse steps, so the light isn't rewritten for tiny changes
    return [round(c * 255) for c in colorsys.hsv_to_rgb(hue / 360, 1, 1)]


def clamp(x):
    return max(0.0, min(1.0, x))


def dynamic_rgb(mode, temp=None):
    """Colour for a sensor-driven mode. Battery: red at 10% and below, green at 80% and above.
    Heat: blue at 40C and below, red at 90C and above."""
    if mode == "battery":
        pct = battery_percent()
        return [255, 255, 255] if pct is None else hue_rgb(120 * clamp((pct - 10) / 70))
    temp = cpu_temp() if temp is None else temp
    return [255, 255, 255] if temp is None else hue_rgb(240 * (1 - clamp((temp - 40) / 50)))


def apply_power(cfg):
    """Keyboard light on boot / while awake / during sleep (G-Helper's lighting-state options)."""
    write("kbd_rgb_state", "1 " + " ".join(str(int(cfg[k])) for k in POWER) + " 1")


def apply(cfg, power=False):
    if power:
        apply_power(cfg)
    write("brightness", str(cfg["brightness"]))
    if cfg["brightness"] > 0:
        if cfg["mode"] in DYNAMIC:  # shown as a static colour picked from the sensor
            set_mode("static", dynamic_rgb(cfg["mode"]), "medium")
        else:
            set_mode(cfg["mode"], cfg["rgb"], cfg["speed"])


def set_mode(mode, rgb, speed):
    """Send one colour/effect to the keyboard."""
    r, g, b = rgb
    # First field 0 = temporary set (G-Helper's 0xb4); 1 would save to the laptop's memory on every change.
    write("kbd_rgb_mode", f"0 {MODES[mode]} {r} {g} {b} {SPEEDS[speed]}")


def step_effect(cfg, step):
    cfg["mode"] = EFFECTS[(EFFECTS.index(cfg["mode"]) + step) % len(EFFECTS)]
    cfg["brightness"] = max(cfg["brightness"], 1)
    apply(cfg)
    save(cfg)


def log(msg):
    print(f"kbd-color: {msg}", file=sys.stderr, flush=True)


def notify(text):
    """Short desktop popup that replaces the previous one instead of stacking. Not waited for;
    the daemon ignores SIGCHLD so the kernel reaps it."""
    try:
        subprocess.Popen(["notify-send", "-a", "Keyboard Light", "-i", "input-keyboard", "-t", "1500",
                          "-h", "string:x-canonical-private-synchronous:kbd-color", "Keyboard light", text],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


EVENT = struct.Struct("llHHi")  # struct input_event: timeval, type, code, value
EV_MSC, MSC_SCAN = 4, 4


class Hotkeys:
    """ASUS Fn hotkeys from the "Asus WMI hotkeys" input device (not the main keyboard).
    One press arrives as a burst of repeats, so a code only counts again after a short gap."""

    def __init__(self):
        dev = next(("/dev/input/" + os.path.basename(d) for d in glob.glob("/sys/class/input/event*")
                    if read_text(d + "/device/name") == HOTKEY_DEVICE), None)
        if dev is None:
            raise KbdError(f"input device '{HOTKEY_DEVICE}' not found")
        try:
            self.fd = os.open(dev, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        except PermissionError:
            raise KbdError(f"No permission to read {dev}. Run ./install.sh from the kbd-color project first.")
        self.last = 0.0

    def fileno(self):
        return self.fd

    def presses(self):
        """Codes of the presses waiting to be read (call when select() says it's readable)."""
        codes = []
        try:
            data = os.read(self.fd, EVENT.size * 64)
        except BlockingIOError:
            return codes
        for sec, usec, typ, code, value in EVENT.iter_unpack(data):
            if typ == EV_MSC and code == MSC_SCAN:
                t = sec + usec / 1e6
                if t - self.last > 0.4:
                    codes.append(value)
                self.last = t
        return codes


IN_CLOSE_WRITE, IN_MOVED_TO = 0x8, 0x80
INOTIFY_EVENT = struct.Struct("iIII")  # struct inotify_event without the name: wd, mask, cookie, len


class ConfigWatch:
    """Readable when the config file has been saved (inotify on its folder)."""

    def __init__(self):
        import ctypes
        libc = ctypes.CDLL(None, use_errno=True)
        folder = os.path.dirname(CONF)
        os.makedirs(folder, exist_ok=True)
        self.fd = libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
        if self.fd < 0 or libc.inotify_add_watch(self.fd, os.fsencode(folder), IN_CLOSE_WRITE | IN_MOVED_TO) < 0:
            raise OSError(ctypes.get_errno(), "inotify")
        self.name = os.fsencode(os.path.basename(CONF))

    def fileno(self):
        return self.fd

    def changed(self):
        """Drain pending events; True if one of them was the config file."""
        hit = False
        while True:
            try:
                data = os.read(self.fd, 4096)
            except BlockingIOError:
                return hit
            i = 0
            while i < len(data):
                n = INOTIFY_EVENT.unpack_from(data, i)[3]
                i += INOTIFY_EVENT.size
                hit |= data[i:i + n].rstrip(b"\0") == self.name
                i += n


INTERVAL = {"battery": 30, "heat": 2}  # seconds between sensor readings
REFRESH = 60  # re-send a dynamic colour this often even if unchanged, e.g. after suspend


def daemon():
    """Apply the saved setting at login, then sleep until something happens: the config file
    is saved, an Fn hotkey is pressed, or (battery / heat modes only) a sensor reading is due.
    With any other effect the process doesn't wake up at all while idle."""
    signal.signal(signal.SIGCHLD, signal.SIG_IGN)  # notify-send popups are reaped by the kernel
    cfg = load(live=False)
    try:
        apply(cfg, power=True)
    except KbdError as e:
        log(e)
    watch = ConfigWatch()
    try:
        keys = Hotkeys()
    except KbdError as e:
        keys = None
        log(f"hotkeys disabled: {e}")
    sent, sent_at, avg, due = None, 0.0, None, 0.0
    while True:
        timeout = max(0.0, due - time.monotonic()) if cfg["mode"] in DYNAMIC else None
        ready = select.select([watch, keys] if keys else [watch], [], [], timeout)[0]
        try:
            if watch in ready and watch.changed():
                cfg, sent, avg, due = load(), None, None, 0.0
            if keys and keys in ready:
                try:
                    codes = keys.presses()
                except OSError as e:  # device went away
                    codes, keys = [], None
                    log(f"hotkeys disabled: {e}")
                for code in codes:
                    if code in HOTKEYS:
                        cfg = load()
                        step_effect(cfg, HOTKEYS[code])  # the save wakes us again via ConfigWatch
                        notify(LABELS[cfg["mode"]])
            now = time.monotonic()
            if cfg["mode"] in DYNAMIC and now >= due:
                due = now + INTERVAL[cfg["mode"]]
                if read_int(os.path.join(LED, "brightness")):
                    temp = None
                    if cfg["mode"] == "heat":
                        t = cpu_temp()
                        if t is not None:
                            avg = t if avg is None else 0.7 * avg + 0.3 * t  # ride out short spikes
                        temp = avg
                    rgb = dynamic_rgb(cfg["mode"], temp)
                    if rgb != sent or now - sent_at >= REFRESH:
                        set_mode("static", rgb, "medium")
                        sent, sent_at = rgb, now
        except KbdError as e:
            log(e)


def parse_color(s):
    s = s.lower().lstrip("#")
    if s in COLORS:
        return list(COLORS[s])
    if len(s) == 6:
        try:
            return [int(s[i:i + 2], 16) for i in (0, 2, 4)]
        except ValueError:
            pass
    return None


APP_ID = "local.kbdcolor.KbdColor"
SWATCHES = ["red", "orange", "yellow", "green", "cyan", "blue", "purple", "pink", "white"]


def gui(cfg):
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gdk, Gio, GLib, Gtk

    class Window(Adw.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Keyboard Light", default_width=460, default_height=760)
            self.loading = True
            self.toasts = Adw.ToastOverlay()
            view = Adw.ToolbarView()
            view.add_top_bar(Adw.HeaderBar())
            page = Adw.PreferencesPage()
            view.set_content(page)
            self.toasts.set_child(view)
            self.set_content(self.toasts)

            # Effect
            grp = Adw.PreferencesGroup(title="Effect")
            self.mode = Adw.ComboRow(title="Effect", model=Gtk.StringList.new([LABELS[m] for m in EFFECTS]))
            self.mode.set_selected(EFFECTS.index(cfg["mode"]))
            self.speed = Adw.ComboRow(title="Speed", model=Gtk.StringList.new(list(SPEEDS)))
            self.speed.set_selected(list(SPEEDS).index(cfg["speed"]))
            grp.add(self.mode)
            grp.add(self.speed)
            page.add(grp)

            # Colour
            self.color_grp = Adw.PreferencesGroup(title="Colour")
            self.picker = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(), valign=Gtk.Align.CENTER)
            self.picker.set_rgba(self.rgba(cfg["rgb"]))
            row = Adw.ActionRow(title="Custom colour")
            row.add_suffix(self.picker)
            self.color_grp.add(row)
            flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=9,
                               column_spacing=6, row_spacing=6, margin_top=8, margin_bottom=8)
            css = Gtk.CssProvider()
            css.load_from_string("".join(f"button.swatch-{n} {{ background: rgb{COLORS[n]}; min-width: 34px;"
                                         f" min-height: 34px; }}" for n in SWATCHES))
            Gtk.StyleContext.add_provider_for_display(self.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            for name in SWATCHES:
                btn = Gtk.Button(tooltip_text=name, css_classes=["circular", f"swatch-{name}"])
                btn.connect("clicked", self.on_swatch, name)
                flow.append(btn)
            self.color_grp.add(flow)
            page.add(self.color_grp)

            # Brightness
            grp = Adw.PreferencesGroup(title="Brightness")
            self.bright = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 3, 1)
            self.bright.set_draw_value(False)
            self.bright.set_hexpand(True)
            self.bright.set_round_digits(0)
            for i, text in enumerate(["Off", "Low", "Medium", "High"]):
                self.bright.add_mark(i, Gtk.PositionType.BOTTOM, text)
            self.bright.set_value(cfg["brightness"])
            row = Adw.ActionRow()
            row.set_child(self.bright)
            grp.add(row)
            page.add(grp)

            # Keyboard light states (same idea as G-Helper's boot / awake / sleep options)
            grp = Adw.PreferencesGroup(title="Keyboard light", description="When the light is allowed to be on")
            self.power = {}
            for key, title in (("boot", "On boot"), ("awake", "While awake"), ("sleep", "During sleep")):
                sw = Adw.SwitchRow(title=title, active=bool(cfg[key]))
                sw.connect("notify::active", self.push_power)
                self.power[key] = sw
                grp.add(sw)
            page.add(grp)

            self.mode.connect("notify::selected", self.push)
            self.speed.connect("notify::selected", self.push)
            self.picker.connect("notify::rgba", self.push)
            self.bright.connect("value-changed", self.push)
            self.loading = False
            self.refresh()

            # Follow changes made elsewhere (Fn+Left hotkey, the command line).
            self.reload_id = 0
            self.monitor = Gio.File.new_for_path(CONF).monitor_file(Gio.FileMonitorFlags.NONE, None)
            self.monitor.connect("changed", self.on_file_changed)

        def on_file_changed(self, *_):
            if not self.reload_id:
                self.reload_id = GLib.timeout_add(150, self.reload)

        def reload(self):
            self.reload_id = 0
            new = load()
            if new != cfg:
                cfg.update(new)
                self.loading = True  # don't write the values back
                self.mode.set_selected(EFFECTS.index(cfg["mode"]))
                self.speed.set_selected(list(SPEEDS).index(cfg["speed"]))
                self.picker.set_rgba(self.rgba(cfg["rgb"]))
                self.bright.set_value(cfg["brightness"])
                for key, sw in self.power.items():
                    sw.set_active(bool(cfg[key]))
                self.loading = False
                self.refresh()
            return GLib.SOURCE_REMOVE

        @staticmethod
        def rgba(rgb):
            c = Gdk.RGBA()
            c.red, c.green, c.blue, c.alpha = (rgb[0] / 255, rgb[1] / 255, rgb[2] / 255, 1)
            return c

        def refresh(self):
            m = EFFECTS[self.mode.get_selected()]
            self.color_grp.set_sensitive(m not in NO_COLOR)
            self.speed.set_sensitive(m not in NO_SPEED)
            self.mode.set_subtitle({
                "battery": "Red when low, green when full. Updates automatically.",
                "heat": "Blue when cool, red when hot. Updates automatically.",
            }.get(m, ""))

        def push_power(self, *_):
            if self.loading:
                return
            for key, sw in self.power.items():
                cfg[key] = sw.get_active()
            try:
                apply_power(cfg)
                save(cfg)
            except KbdError as e:
                self.toasts.add_toast(Adw.Toast(title=str(e), timeout=6))

        def on_swatch(self, _btn, name):
            self.picker.set_rgba(self.rgba(COLORS[name]))  # fires push via notify::rgba

        def push(self, *_):
            if self.loading:
                return
            c = self.picker.get_rgba()
            cfg["rgb"] = [round(c.red * 255), round(c.green * 255), round(c.blue * 255)]
            cfg["mode"] = EFFECTS[self.mode.get_selected()]
            cfg["speed"] = list(SPEEDS)[self.speed.get_selected()]
            cfg["brightness"] = int(round(self.bright.get_value()))
            self.refresh()
            try:
                apply(cfg)
                save(cfg)
            except KbdError as e:
                self.toasts.add_toast(Adw.Toast(title=str(e), timeout=6))

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID)
            self.connect("activate", lambda app: (app.props.active_window or Window(app)).present())

    App().run([])


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if not os.path.isdir(LED):
        sys.exit(f"kbd-color: {LED} not found (needs an ASUS laptop with asus-wmi)")

    cmd = argv[0].lower()
    cfg = load(live=cmd != "apply")  # apply restores the saved brightness too

    if cmd == "gui":
        return gui(cfg)
    if cmd == "daemon":
        return daemon()
    if cmd == "keys":
        keys = Hotkeys()
        print("press ASUS Fn hotkeys (Ctrl+C to stop)")
        try:
            while True:
                select.select([keys], [], [])
                for code in keys.presses():
                    print(f"0x{code:x}" + ("  (mapped)" if code in HOTKEYS else ""), flush=True)
        except KeyboardInterrupt:
            return
    if cmd in ("next", "prev"):
        step_effect(cfg, 1 if cmd == "next" else -1)
        return print(LABELS[cfg["mode"]])
    if cmd == "apply":
        return apply(cfg, power=True)
    if cmd == "power":
        if len(argv) != 3 or argv[1] not in POWER or argv[2] not in ("on", "off"):
            sys.exit("kbd-color: usage: kbd-color power boot|awake|sleep on|off")
        cfg[argv[1]] = argv[2] == "on"
        apply_power(cfg)
        return save(cfg)
    if cmd == "off":
        cfg["brightness"] = 0
    elif cmd == "on":
        cfg["brightness"] = max(cfg["brightness"], 1)
    elif cmd == "brightness":
        if len(argv) != 2 or argv[1] not in ("0", "1", "2", "3"):
            sys.exit("kbd-color: brightness takes 0-3")
        cfg["brightness"] = int(argv[1])
    else:
        if cmd in EFFECTS:
            cfg["mode"] = cmd
        else:
            rgb = parse_color(cmd)
            if rgb is None:
                sys.exit(f"kbd-color: unknown command or colour '{cmd}' (try --help)")
            cfg["mode"], cfg["rgb"] = "static", rgb
        for a in argv[1:]:
            if a.lower() in SPEEDS:
                cfg["speed"] = a.lower()
            elif parse_color(a):
                cfg["rgb"] = parse_color(a)
            else:
                sys.exit(f"kbd-color: unknown argument '{a}'")
        cfg["brightness"] = max(cfg["brightness"], 1)

    apply(cfg)
    save(cfg)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KbdError as e:
        sys.exit(f"kbd-color: {e}")
