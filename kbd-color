#!/usr/bin/env python3
"""kbd-color: tiny keyboard light controller for ASUS laptops (asus-wmi sysfs).

  kbd-color red                 solid colour by name
  kbd-color ff8800              solid colour by hex
  kbd-color cycle [speed]       effects: static breathe cycle strobe
  kbd-color battery             colour follows battery level (red low -> green full)
  kbd-color heat                colour follows CPU temperature (blue cool -> red hot)
  kbd-color breathe blue slow   effect + colour + speed (slow|medium|fast)
  kbd-color brightness 0-3
  kbd-color off | on
  kbd-color power awake on      keyboard light on boot / awake / sleep: on|off
  kbd-color apply               re-apply the saved setting (used at login)
  kbd-color daemon              keeps battery/heat colours live (run by the systemd user service)
  kbd-color gui                 small window
"""
import colorsys
import glob
import json
import os
import sys
import time

LED = os.environ.get("KBD_COLOR_LED", "/sys/class/leds/asus::kbd_backlight")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "kbd-color.json")

# Effect numbers as used by G-Helper / the asus-wmi driver.
MODES = {"static": 0, "breathe": 1, "cycle": 2, "strobe": 10}
# Software-driven "effects": the daemon turns a sensor reading into a static colour.
DYNAMIC = ("battery", "heat")
EFFECTS = list(MODES) + list(DYNAMIC)
LABELS = {"static": "Static", "breathe": "Breathe", "cycle": "Color cycle", "strobe": "Strobe",
          "battery": "Battery level", "heat": "CPU temperature"}
NO_COLOR = {"cycle", *DYNAMIC}       # these pick their own colours
NO_SPEED = {"static", *DYNAMIC}        # these don't animate
POWER = ("boot", "awake", "sleep")
SPEEDS = {"slow": 0, "medium": 1, "fast": 2}
COLORS = {
    "red": (255, 0, 0), "green": (0, 255, 0), "blue": (0, 0, 255),
    "white": (255, 255, 255), "yellow": (255, 255, 0), "cyan": (0, 255, 255),
    "magenta": (255, 0, 255), "purple": (128, 0, 255), "orange": (255, 100, 0),
    "pink": (255, 60, 150),
}
DEFAULT = {"mode": "static", "rgb": [255, 255, 255], "speed": "medium", "brightness": 3,
           "boot": True, "awake": True, "sleep": True}


def load():
    try:
        with open(CONF) as f:
            cfg = {**DEFAULT, **json.load(f)}
        if cfg["mode"] == "rainbow":  # removed: this keyboard has no rainbow, colour cycle is its version
            cfg["mode"] = "cycle"
        if cfg["mode"] not in EFFECTS:  # e.g. another effect that was removed
            cfg["mode"] = "static"
        return cfg
    except (OSError, ValueError):
        return dict(DEFAULT)


def save(cfg):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        json.dump(cfg, f)


class KbdError(Exception):
    pass


def write(name, value):
    path = os.path.join(LED, name)
    try:
        with open(path, "w") as f:
            f.write(value)
    except PermissionError:
        raise KbdError(f"No permission to write {path}. Run ./install.sh from the kbd-color project first.")
    except OSError as e:
        raise KbdError(f"{path}: {e}")


def read_int(path):
    try:
        with open(path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def battery_percent():
    for d in sorted(glob.glob("/sys/class/power_supply/BAT*")):
        v = read_int(d + "/capacity")
        if v is not None:
            return v
    return None


def cpu_temp():
    """CPU package temperature in degrees C, or None."""
    for d in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            with open(d + "/name") as f:
                if f.read().strip() != "coretemp":
                    continue
        except OSError:
            continue
        v = read_int(d + "/temp1_input")
        if v is not None:
            return v / 1000
    for d in glob.glob("/sys/class/thermal/thermal_zone*"):
        try:
            with open(d + "/type") as f:
                if f.read().strip() != "x86_pkg_temp":
                    continue
        except OSError:
            continue
        v = read_int(d + "/temp")
        if v is not None:
            return v / 1000
    return None


def hue_rgb(hue):
    hue = round(hue / 5) * 5  # coarse steps, so the light isn't rewritten for tiny changes
    return [round(c * 255) for c in colorsys.hsv_to_rgb(hue / 360, 1, 1)]


def clamp(x):
    return max(0.0, min(1.0, x))


def dynamic_rgb(mode, temp=None):
    """Colour for a sensor-driven mode. Battery: red at 10% and below, green at 80% and above.
    Heat: blue at 40C and below, red at 90C and above."""
    if mode == "battery":
        pct = battery_percent()
        return [255, 255, 255] if pct is None else hue_rgb(120 * clamp((pct - 10) / 70))
    temp = cpu_temp() if temp is None else temp
    return [255, 255, 255] if temp is None else hue_rgb(240 * (1 - clamp((temp - 40) / 50)))


def apply_power(cfg):
    """Keyboard light on boot / while awake / during sleep (G-Helper's lighting-state options)."""
    write("kbd_rgb_state", "1 " + " ".join(str(int(cfg[k])) for k in POWER) + " 1")


def apply(cfg, power=False):
    if power:
        apply_power(cfg)
    write("brightness", str(cfg["brightness"]))
    if cfg["brightness"] > 0:
        set_mode(cfg["mode"], cfg["rgb"], cfg["speed"])


def set_mode(mode, rgb, speed):
    """Send one colour/effect to the keyboard. Dynamic modes are shown as a static colour."""
    if mode in DYNAMIC:
        mode, rgb, speed = "static", dynamic_rgb(mode), "medium"
    r, g, b = rgb
    # First field 0 = temporary set (G-Helper's 0xb4); 1 would save to the laptop's memory on every change.
    write("kbd_rgb_mode", f"0 {MODES[mode]} {r} {g} {b} {SPEEDS[speed]}")


def daemon():
    """Apply the saved setting, then keep battery / heat colours up to date."""
    cfg = load()
    try:
        apply(cfg, power=True)
    except KbdError as e:
        print(f"kbd-color: {e}", file=sys.stderr)
    mtime, sent, avg, tick = None, None, None, 0
    while True:
        try:
            m = os.stat(CONF).st_mtime
        except OSError:
            m = None
        if m != mtime:
            mtime, cfg, sent = m, load(), None
        if cfg["mode"] in DYNAMIC and read_int(os.path.join(LED, "brightness")):
            temp = None
            if cfg["mode"] == "heat":
                t = cpu_temp()
                if t is not None:
                    avg = t if avg is None else 0.7 * avg + 0.3 * t  # ride out short spikes
                temp = avg
            rgb = dynamic_rgb(cfg["mode"], temp)
            tick += 1
            if rgb != sent or tick % 30 == 0:  # also refresh now and then, e.g. after suspend
                try:
                    set_mode(cfg["mode"], rgb, "medium")
                    sent = rgb
                except KbdError as e:
                    print(f"kbd-color: {e}", file=sys.stderr)
        time.sleep(2)


def parse_color(s):
    s = s.lower().lstrip("#")
    if s in COLORS:
        return list(COLORS[s])
    if len(s) == 6:
        try:
            return [int(s[i:i + 2], 16) for i in (0, 2, 4)]
        except ValueError:
            pass
    return None


APP_ID = "local.kbdcolor.KbdColor"
SWATCHES = ["red", "orange", "yellow", "green", "cyan", "blue", "purple", "pink", "white"]


def gui(cfg):
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gdk, Gtk

    class Window(Adw.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Keyboard Light", default_width=460, default_height=760)
            self.loading = True
            self.toasts = Adw.ToastOverlay()
            view = Adw.ToolbarView()
            view.add_top_bar(Adw.HeaderBar())
            page = Adw.PreferencesPage()
            view.set_content(page)
            self.toasts.set_child(view)
            self.set_content(self.toasts)

            # Effect
            grp = Adw.PreferencesGroup(title="Effect")
            self.mode = Adw.ComboRow(title="Effect", model=Gtk.StringList.new([LABELS[m] for m in EFFECTS]))
            self.mode.set_selected(EFFECTS.index(cfg["mode"]))
            self.speed = Adw.ComboRow(title="Speed", model=Gtk.StringList.new(list(SPEEDS)))
            self.speed.set_selected(list(SPEEDS).index(cfg["speed"]))
            grp.add(self.mode)
            grp.add(self.speed)
            page.add(grp)

            # Colour
            self.color_grp = Adw.PreferencesGroup(title="Colour")
            self.picker = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(), valign=Gtk.Align.CENTER)
            self.picker.set_rgba(self.rgba(cfg["rgb"]))
            row = Adw.ActionRow(title="Custom colour")
            row.add_suffix(self.picker)
            self.color_grp.add(row)
            flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=9,
                               column_spacing=6, row_spacing=6, margin_top=8, margin_bottom=8)
            for name in SWATCHES:
                btn = Gtk.Button(width_request=34, height_request=34, tooltip_text=name)
                btn.add_css_class("circular")
                css = Gtk.CssProvider()
                r, g, b = COLORS[name]
                css.load_from_string(f"button {{ background: rgb({r},{g},{b}); min-width: 34px; min-height: 34px; }}")
                btn.get_style_context().add_provider(css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
                btn.connect("clicked", self.on_swatch, name)
                flow.append(btn)
            self.color_grp.add(flow)
            page.add(self.color_grp)

            # Brightness
            grp = Adw.PreferencesGroup(title="Brightness")
            self.bright = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 3, 1)
            self.bright.set_draw_value(False)
            self.bright.set_hexpand(True)
            self.bright.set_round_digits(0)
            for i, text in enumerate(["Off", "Low", "Medium", "High"]):
                self.bright.add_mark(i, Gtk.PositionType.BOTTOM, text)
            self.bright.set_value(cfg["brightness"])
            row = Adw.ActionRow()
            row.set_child(self.bright)
            grp.add(row)
            page.add(grp)

            # Keyboard light states (same idea as G-Helper's boot / awake / sleep options)
            grp = Adw.PreferencesGroup(title="Keyboard light", description="When the light is allowed to be on")
            self.power = {}
            for key, title in (("boot", "On boot"), ("awake", "While awake"), ("sleep", "During sleep")):
                sw = Adw.SwitchRow(title=title, active=bool(cfg[key]))
                sw.connect("notify::active", self.push_power)
                self.power[key] = sw
                grp.add(sw)
            page.add(grp)

            self.mode.connect("notify::selected", self.push)
            self.speed.connect("notify::selected", self.push)
            self.picker.connect("notify::rgba", self.push)
            self.bright.connect("value-changed", self.push)
            self.loading = False
            self.refresh()

        @staticmethod
        def rgba(rgb):
            c = Gdk.RGBA()
            c.red, c.green, c.blue, c.alpha = (rgb[0] / 255, rgb[1] / 255, rgb[2] / 255, 1)
            return c

        def refresh(self):
            m = EFFECTS[self.mode.get_selected()]
            self.color_grp.set_sensitive(m not in NO_COLOR)
            self.speed.set_sensitive(m not in NO_SPEED)
            self.mode.set_subtitle({
                "battery": "Red when low, green when full. Updates automatically.",
                "heat": "Blue when cool, red when hot. Updates automatically.",
            }.get(m, ""))

        def push_power(self, *_):
            if self.loading:
                return
            for key, sw in self.power.items():
                cfg[key] = sw.get_active()
            try:
                apply_power(cfg)
                save(cfg)
            except KbdError as e:
                self.toasts.add_toast(Adw.Toast(title=str(e), timeout=6))

        def on_swatch(self, _btn, name):
            self.picker.set_rgba(self.rgba(COLORS[name]))  # fires push via notify::rgba

        def push(self, *_):
            if self.loading:
                return
            c = self.picker.get_rgba()
            cfg["rgb"] = [round(c.red * 255), round(c.green * 255), round(c.blue * 255)]
            cfg["mode"] = EFFECTS[self.mode.get_selected()]
            cfg["speed"] = list(SPEEDS)[self.speed.get_selected()]
            cfg["brightness"] = int(round(self.bright.get_value()))
            self.refresh()
            try:
                apply(cfg)
                save(cfg)
            except KbdError as e:
                self.toasts.add_toast(Adw.Toast(title=str(e), timeout=6))

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID)
            self.connect("activate", lambda app: (app.props.active_window or Window(app)).present())

    App().run([])


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if not os.path.isdir(LED):
        sys.exit(f"kbd-color: {LED} not found (needs an ASUS laptop with asus-wmi)")

    cfg = load()
    cmd = argv[0].lower()

    if cmd == "gui":
        return gui(cfg)
    if cmd == "daemon":
        return daemon()
    if cmd == "apply":
        return apply(cfg, power=True)
    if cmd == "power":
        if len(argv) != 3 or argv[1] not in POWER or argv[2] not in ("on", "off"):
            sys.exit("kbd-color: usage: kbd-color power boot|awake|sleep on|off")
        cfg[argv[1]] = argv[2] == "on"
        apply_power(cfg)
        return save(cfg)
    if cmd == "off":
        cfg["brightness"] = 0
    elif cmd == "on":
        cfg["brightness"] = max(cfg["brightness"], 1)
    elif cmd == "brightness":
        if len(argv) < 2 or argv[1] not in "0123" or len(argv[1]) != 1:
            sys.exit("kbd-color: brightness takes 0-3")
        cfg["brightness"] = int(argv[1])
    else:
        if cmd in EFFECTS:
            cfg["mode"] = cmd
        else:
            rgb = parse_color(cmd)
            if rgb is None:
                sys.exit(f"kbd-color: unknown command or colour '{cmd}' (try --help)")
            cfg["mode"], cfg["rgb"] = "static", rgb
        for a in argv[1:]:
            if a.lower() in SPEEDS:
                cfg["speed"] = a.lower()
            elif parse_color(a):
                cfg["rgb"] = parse_color(a)
            else:
                sys.exit(f"kbd-color: unknown argument '{a}'")
        cfg["brightness"] = max(cfg["brightness"], 1)

    apply(cfg)
    save(cfg)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KbdError as e:
        sys.exit(f"kbd-color: {e}")
